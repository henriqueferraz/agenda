generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plans {
  BASIC
  PROFESSIONAL
}

enum UserRole {
  master
  enterprise
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  cpf                String?   @unique
  role               UserRole  @default(enterprise)
  trialEndsAt        DateTime?
  emailVerified      DateTime?
  image              String?
  password_hash      String?
  address            String?   @default("")
  phone              String?   @default("")
  status             Boolean   @default(true)
  stripe_customer_id String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  cnpj               String?   @default("")
  activity           String?   @default("")
  be_called          String?   @unique
  token_called       String?   @unique
  fri_times          String[]  @default([])
  mon_times          String[]  @default([])
  sat_times          String[]  @default([])
  sun_times          String[]  @default([])
  thu_times          String[]  @default([])
  tue_times          String[]  @default([])
  wed_times          String[]  @default([])

  Address       Address?
  appointment   Appointment[]
  employee      Employee[]
  reminders     Reminder[]
  service       Service[]
  subscription  Subscription?
  stopDays      StopDay[]
  refreshTokens RefreshToken[]
  emailOtps     EmailOtp[]
  resetTokens   PasswordResetToken[]
  securityLogs  SecurityLog[]
  messageConfig MessageConfig?
  messageLogs   MessageLog[]
  clients       Client[]
}

model Address {
  id           String   @id
  street       String?  @default("")
  number       String?  @default("")
  complement   String?  @default("")
  neighborhood String?  @default("")
  city         String?  @default("")
  state        String?  @default("")
  zip_code     String?  @default("")
  country      String?  @default("")
  UserId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  user User @relation(fields: [UserId], references: [id])
}

model StopDay {
  id         String   @id @default(cuid())
  date       DateTime
  motivation String
  UserId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [UserId], references: [id])

  @@index([UserId, date])
}

model Employee {
  id        String    @id
  name      String
  email     String    @unique
  phone     String
  function  String
  status    Boolean   @default(true)
  mon_times String[]  @default([])
  tue_times String[]  @default([])
  wed_times String[]  @default([])
  thu_times String[]  @default([])
  fri_times String[]  @default([])
  sat_times String[]  @default([])
  sun_times String[]  @default([])
  UserId    String
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime

  services     EmployeeService[]
  user         User              @relation(fields: [UserId], references: [id])
  appointments Appointment[]
}

// Nova tabela intermediária para relação many-to-many
model EmployeeService {
  id         String   @id @default(cuid())
  employeeId String
  serviceId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId]) // Evita duplicatas
  @@index([employeeId])
  @@index([serviceId])
}

model Service {
  id        String    @id @default(cuid())
  name      String
  price     Int
  duration  Int
  status    Boolean   @default(true)
  UserId    String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointment Appointment[]
  employee    EmployeeService[]

  user User @relation(fields: [UserId], references: [id])
}

model Reminder {
  id          String   @id @default(cuid())
  description String
  UserId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [UserId], references: [id])
}

enum AppointmentStatus {
  confirmed
  cancelled
}

model Appointment {
  id              String            @id @default(cuid())
  appointmentDate DateTime
  time            String
  status          AppointmentStatus @default(confirmed)
  cancelReason    String?
  cancelledAt     DateTime?
  cancelledBy     String?
  managementToken String?           @unique
  userId          String
  serviceId       String
  employeeId      String
  clientId        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  service      Service              @relation(fields: [serviceId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
  employee     Employee             @relation(fields: [employeeId], references: [id])
  client       Client               @relation(fields: [clientId], references: [id])
  history      AppointmentHistory[]
  reminderLogs ReminderLog[]
  messageLogs  MessageLog[]

  @@unique([employeeId, appointmentDate, time])
  @@index([userId, appointmentDate])
  @@index([employeeId, appointmentDate])
  @@index([serviceId])
  @@index([status])
  @@index([managementToken])
  @@index([clientId])
}

model AppointmentHistory {
  id            String   @id @default(cuid())
  appointmentId String
  action        String
  performedBy   String
  changes       Json?
  reason        String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
}

model Subscription {
  id        String   @id @default(cuid())
  status    String
  plan      Plans
  priceId   String
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model LoginAttempt {
  id          String    @id @default(cuid())
  email       String
  count       Int       @default(0)
  lastAttempt DateTime  @default(now())
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
}

model IpRateLimit {
  id             String    @id @default(cuid())
  ip             String    @unique
  count          Int       @default(0)
  firstAttemptAt DateTime  @default(now())
  blockedUntil   DateTime?
  updatedAt      DateTime  @updatedAt
}

model EmailOtp {
  id          String    @id @default(cuid())
  email       String
  codeHash    String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  lockedUntil DateTime?
  lastSentAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?

  @@index([email])
  @@index([codeHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@index([email])
  @@index([tokenHash])
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  ip        String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([action])
}

model MessageConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  reminder7d      Boolean  @default(true)
  reminder24h     Boolean  @default(true)
  reminder2h      Boolean  @default(true)
  reminderChannel String   @default("whatsapp")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ReminderLog {
  id            String   @id @default(cuid())
  appointmentId String
  type          String
  channel       String
  status        String
  sentAt        DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([appointmentId, type])
  @@index([appointmentId])
}

model MessageLog {
  id             String       @id @default(cuid())
  userId         String
  type           String
  recipientName  String
  recipientPhone String
  recipientEmail String       @default("")
  appointmentId  String?
  message        String       @db.Text
  status         String       @default("sent")
  sentAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([userId, sentAt])
  @@index([appointmentId])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String
  phone     String
  cpf       String
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@unique([userId, cpf])
  @@unique([userId, email])
  @@index([userId])
  @@index([cpf])
}
